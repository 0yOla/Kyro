{
  "name": "Kyro",
  "version": "1.0.0",
  "description": "Kyro is an AI-powered agent that automatically generates and publishes high-quality, engaging content on Hashnode. It selects trending topics, writes detailed articles, and fetches relevant cover images, saving time for bloggers and developers. Integrated with Hashnode, it automates the posting process while optimizing content for SEO, ensuring a consistent flow of fresh and relevant blog posts.",
  "main": "src/index.ts",
  "scripts": {
    "start": "node api.js && tsc && node build/index.js",
    "server": "tsc && node build/server.js",
    "kyro": "tsc && node  --no-warnings  build/agent/index.js",
    "del": "tsc && node  --no-warnings  build/utils/DeleteDatabase.js",
    "post": "tsc && node  --no-warnings  build/agent/features/index.js",
    "train-agent:web": "tsc && node build/agent/training/WebsiteScraping.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier . --check",
    "format:fix": "prettier . --write",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/david-patrick-chuks/Kyro.git"
  },
  "keywords": [
    "hashnode",
    "gpt",
    "llm",
    "post",
    "gemini",
    "graphql",
    "api",
    "generative",
    "ai",
    "hashnode",
    "Kyro"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/david-patrick-chuks/Kyro/issues"
  },
  "homepage": "https://github.com/david-patrick-chuks/Kyro#readme",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "axios": "^1.20.0",
    "chalk": "^4.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron": "^3.5.0",
    "csv-parser": "^3.2.1",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "helmet": "^8.3.0",
    "instagram-private-api": "^1.46.1",
    "jsdom": "^26.0.0",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.4",
    "morgan": "^1.12.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "openai": "^7.32.0",
    "pdf-parse": "^1.1.1",
    "puppeteer": "^24.2.0",
    "request": "^2.88.2",
    "request-promise": "^4.2.6",
    "textract": "^2.5.0",
    "twitter-api-v2": "^1.29.1",
    "typescript": "^5.7.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/figlet": "^1.7.0",
    "@types/jsdom": "^21.1.7",
    "@types/mime-types": "^2.1.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^6.4.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/request": "^2.48.13",
    "@types/textract": "^2.4.5",
    "boxen": "^8.0.1",
    "copyfiles": "^2.4.1",
    "figlet": "^1.12.0",
    "husky": "^9.1.7",
    "i": "^0.3.7",
    "mime-types": "^2.1.35",
    "npm": "^11.1.0",
    "ora": "^8.1.1",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  }
}
